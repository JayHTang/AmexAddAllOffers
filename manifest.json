{
  "name": "Amex Offer Adder Extension",
  "description": "Add all AMEX offers in your account with one click",
  "version": "1.1",
  "manifest_version": 3,
  "author": "Jay Tang",
  "icons": {
    "128": "default.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "default.png",
    "default_title": "Amex Offer Adder"
  },
  "content_scripts": [
    {
      "matches": ["https://*.americanexpress.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage"]
}
